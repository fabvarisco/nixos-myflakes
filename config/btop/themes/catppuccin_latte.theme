# Catppuccin Latte theme for btop

# Main background
theme[main_bg]="#eff1f5"

# Main text color
theme[main_fg]="#4c4f69"

# Title color for boxes
theme[title]="#4c4f69"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#1e66f5"

# Background color of selected items
theme[selected_bg]="#ccd0da"

# Foreground color of selected items
theme[selected_fg]="#4c4f69"

# Color of inactive/disabled text
theme[inactive_fg]="#9ca0b0"

# Color of text appearing on top of graphs
theme[graph_text]="#6c6f85"

# Misc colors for processes box
theme[proc_misc]="#7287fd"

# CPU box outline color
theme[cpu_box]="#8839ef"

# Memory/disks box outline color
theme[mem_box]="#40a02b"

# Net box outline color
theme[net_box]="#ea76cb"

# Processes box outline color
theme[proc_box]="#1e66f5"

# Box divider line and target line
theme[div_line]="#bcc0cc"

# Temperature graph color (from low to high)
theme[temp_start]="#179299"
theme[temp_mid]="#df8e1d"
theme[temp_end]="#d20f39"

# CPU graph colors
theme[cpu_start]="#179299"
theme[cpu_mid]="#40a02b"
theme[cpu_end]="#8839ef"

# Mem/Disk free meter
theme[free_start]="#40a02b"
theme[free_mid]="#df8e1d"
theme[free_end]="#d20f39"

# Mem/Disk cached meter
theme[cached_start]="#1e66f5"
theme[cached_mid]="#7287fd"
theme[cached_end]="#8839ef"

# Mem/Disk available meter
theme[available_start]="#40a02b"
theme[available_mid]="#df8e1d"
theme[available_end]="#d20f39"

# Mem/Disk used meter
theme[used_start]="#179299"
theme[used_mid]="#df8e1d"
theme[used_end]="#d20f39"

# Download graph colors
theme[download_start]="#1e66f5"
theme[download_mid]="#7287fd"
theme[download_end]="#8839ef"

# Upload graph colors
theme[upload_start]="#40a02b"
theme[upload_mid]="#df8e1d"
theme[upload_end]="#fe640b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#179299"
theme[process_mid]="#1e66f5"
theme[process_end]="#8839ef"
