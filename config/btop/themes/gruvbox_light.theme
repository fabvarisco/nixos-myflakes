# Gruvbox Light theme for btop

# Main background
theme[main_bg]="#fbf1c7"

# Main text color
theme[main_fg]="#3c3836"

# Title color for boxes
theme[title]="#3c3836"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#076678"

# Background color of selected items
theme[selected_bg]="#d5c4a1"

# Foreground color of selected items
theme[selected_fg]="#3c3836"

# Color of inactive/disabled text
theme[inactive_fg]="#a89984"

# Color of text appearing on top of graphs
theme[graph_text]="#504945"

# Misc colors for processes box
theme[proc_misc]="#076678"

# CPU box outline color
theme[cpu_box]="#8f3f71"

# Memory/disks box outline color
theme[mem_box]="#79740e"

# Net box outline color
theme[net_box]="#b16286"

# Processes box outline color
theme[proc_box]="#076678"

# Box divider line and target line
theme[div_line]="#bdae93"

# Temperature graph color (from low to high)
theme[temp_start]="#427b58"
theme[temp_mid]="#b57614"
theme[temp_end]="#9d0006"

# CPU graph colors
theme[cpu_start]="#427b58"
theme[cpu_mid]="#076678"
theme[cpu_end]="#8f3f71"

# Mem/Disk free meter
theme[free_start]="#79740e"
theme[free_mid]="#b57614"
theme[free_end]="#9d0006"

# Mem/Disk cached meter
theme[cached_start]="#076678"
theme[cached_mid]="#458588"
theme[cached_end]="#8f3f71"

# Mem/Disk available meter
theme[available_start]="#79740e"
theme[available_mid]="#b57614"
theme[available_end]="#9d0006"

# Mem/Disk used meter
theme[used_start]="#427b58"
theme[used_mid]="#b57614"
theme[used_end]="#9d0006"

# Download graph colors
theme[download_start]="#076678"
theme[download_mid]="#458588"
theme[download_end]="#8f3f71"

# Upload graph colors
theme[upload_start]="#79740e"
theme[upload_mid]="#b57614"
theme[upload_end]="#af3a03"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#427b58"
theme[process_mid]="#076678"
theme[process_end]="#8f3f71"
