# Gruvbox Dark theme for btop

# Main background
theme[main_bg]="#282828"

# Main text color
theme[main_fg]="#ebdbb2"

# Title color for boxes
theme[title]="#ebdbb2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#83a598"

# Background color of selected items
theme[selected_bg]="#3c3836"

# Foreground color of selected items
theme[selected_fg]="#ebdbb2"

# Color of inactive/disabled text
theme[inactive_fg]="#665c54"

# Color of text appearing on top of graphs
theme[graph_text]="#d5c4a1"

# Misc colors for processes box
theme[proc_misc]="#83a598"

# CPU box outline color
theme[cpu_box]="#b16286"

# Memory/disks box outline color
theme[mem_box]="#98971a"

# Net box outline color
theme[net_box]="#d3869b"

# Processes box outline color
theme[proc_box]="#458588"

# Box divider line and target line
theme[div_line]="#504945"

# Temperature graph color (from low to high)
theme[temp_start]="#689d6a"
theme[temp_mid]="#d79921"
theme[temp_end]="#cc241d"

# CPU graph colors
theme[cpu_start]="#689d6a"
theme[cpu_mid]="#83a598"
theme[cpu_end]="#b16286"

# Mem/Disk free meter
theme[free_start]="#98971a"
theme[free_mid]="#d79921"
theme[free_end]="#cc241d"

# Mem/Disk cached meter
theme[cached_start]="#458588"
theme[cached_mid]="#83a598"
theme[cached_end]="#b16286"

# Mem/Disk available meter
theme[available_start]="#98971a"
theme[available_mid]="#d79921"
theme[available_end]="#cc241d"

# Mem/Disk used meter
theme[used_start]="#689d6a"
theme[used_mid]="#d79921"
theme[used_end]="#cc241d"

# Download graph colors
theme[download_start]="#458588"
theme[download_mid]="#83a598"
theme[download_end]="#b16286"

# Upload graph colors
theme[upload_start]="#98971a"
theme[upload_mid]="#d79921"
theme[upload_end]="#d65d0e"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#689d6a"
theme[process_mid]="#83a598"
theme[process_end]="#b16286"
