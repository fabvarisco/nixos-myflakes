# Rose Pine theme for btop

# Main background
theme[main_bg]="#191724"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#e0def4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9ccfd8"

# Background color of selected items
theme[selected_bg]="#26233a"

# Foreground color of selected items
theme[selected_fg]="#e0def4"

# Color of inactive/disabled text
theme[inactive_fg]="#6e6a86"

# Color of text appearing on top of graphs
theme[graph_text]="#e0def4"

# Misc colors for processes box
theme[proc_misc]="#c4a7e7"

# CPU box outline color
theme[cpu_box]="#c4a7e7"

# Memory/disks box outline color
theme[mem_box]="#31748f"

# Net box outline color
theme[net_box]="#9ccfd8"

# Processes box outline color
theme[proc_box]="#31748f"

# Box divider line and target line
theme[div_line]="#393552"

# Temperature graph color (from low to high)
theme[temp_start]="#9ccfd8"
theme[temp_mid]="#f6c177"
theme[temp_end]="#eb6f92"

# CPU graph colors
theme[cpu_start]="#9ccfd8"
theme[cpu_mid]="#31748f"
theme[cpu_end]="#c4a7e7"

# Mem/Disk free meter
theme[free_start]="#31748f"
theme[free_mid]="#f6c177"
theme[free_end]="#eb6f92"

# Mem/Disk cached meter
theme[cached_start]="#31748f"
theme[cached_mid]="#c4a7e7"
theme[cached_end]="#ebbcba"

# Mem/Disk available meter
theme[available_start]="#31748f"
theme[available_mid]="#f6c177"
theme[available_end]="#eb6f92"

# Mem/Disk used meter
theme[used_start]="#9ccfd8"
theme[used_mid]="#f6c177"
theme[used_end]="#eb6f92"

# Download graph colors
theme[download_start]="#31748f"
theme[download_mid]="#c4a7e7"
theme[download_end]="#ebbcba"

# Upload graph colors
theme[upload_start]="#31748f"
theme[upload_mid]="#f6c177"
theme[upload_end]="#ebbcba"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9ccfd8"
theme[process_mid]="#31748f"
theme[process_end]="#c4a7e7"
