# Nord theme for btop

# Main background
theme[main_bg]="#2e3440"

# Main text color
theme[main_fg]="#eceff4"

# Title color for boxes
theme[title]="#eceff4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#88c0d0"

# Background color of selected items
theme[selected_bg]="#434c5e"

# Foreground color of selected items
theme[selected_fg]="#eceff4"

# Color of inactive/disabled text
theme[inactive_fg]="#4c566a"

# Color of text appearing on top of graphs
theme[graph_text]="#d8dee9"

# Misc colors for processes box
theme[proc_misc]="#81a1c1"

# CPU box outline color
theme[cpu_box]="#b48ead"

# Memory/disks box outline color
theme[mem_box]="#a3be8c"

# Net box outline color
theme[net_box]="#88c0d0"

# Processes box outline color
theme[proc_box]="#81a1c1"

# Box divider line and target line
theme[div_line]="#4c566a"

# Temperature graph color (from low to high)
theme[temp_start]="#8fbcbb"
theme[temp_mid]="#ebcb8b"
theme[temp_end]="#bf616a"

# CPU graph colors
theme[cpu_start]="#8fbcbb"
theme[cpu_mid]="#88c0d0"
theme[cpu_end]="#b48ead"

# Mem/Disk free meter
theme[free_start]="#a3be8c"
theme[free_mid]="#ebcb8b"
theme[free_end]="#bf616a"

# Mem/Disk cached meter
theme[cached_start]="#5e81ac"
theme[cached_mid]="#81a1c1"
theme[cached_end]="#88c0d0"

# Mem/Disk available meter
theme[available_start]="#a3be8c"
theme[available_mid]="#ebcb8b"
theme[available_end]="#bf616a"

# Mem/Disk used meter
theme[used_start]="#8fbcbb"
theme[used_mid]="#ebcb8b"
theme[used_end]="#bf616a"

# Download graph colors
theme[download_start]="#5e81ac"
theme[download_mid]="#81a1c1"
theme[download_end]="#88c0d0"

# Upload graph colors
theme[upload_start]="#a3be8c"
theme[upload_mid]="#ebcb8b"
theme[upload_end]="#d08770"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#8fbcbb"
theme[process_mid]="#88c0d0"
theme[process_end]="#b48ead"
