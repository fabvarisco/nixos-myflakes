/* Generated by theme-switcher - {{THEME_NAME}} */

window {
    margin: 0px;
    border: 5px solid {{BASE}};
    background-color: {{TEXT}};
    border-radius: 20px;
}

#input {
    padding: 4px;
    margin: 4px;
    padding-left: 20px;
    border: none;
    color: {{TEXT}};
    font-weight: bold;
    background-color: {{BASE}};
    background: none;
    outline: none;
    border-radius: 15px;
    margin: 10px;
    margin-bottom: 2px;
}

#input:focus {
    border: 0px solid {{BASE}};
}

#inner-box {
    margin: 4px;
    border: 10px solid {{BASE}};
    color: {{TEXT}};
    font-weight: 400;
    background-color: {{BASE}};
    border-radius: 15px;
}

#outer-box {
    margin: 0px;
    border: none;
    border-radius: 15px;
    background-color: {{BASE}};
}

#scroll {
    margin-top: 5px;
    border: none;
    border-radius: 15px;
    margin-bottom: 5px;
}

#img {
    padding: 5px;
    margin-right: 3px;
}

#img:selected {
    background-color: {{BLUE}};
    border-radius: 15px;
}

#text:selected {
    color: {{BASE}};
    margin: 0px 0px;
    border: none;
    font-weight: bold;
    border-radius: 15px;
    background-color: {{BLUE}};
}

#entry {
    margin: 0px 0px;
    border: none;
    border-radius: 15px;
    background-color: transparent;
}

#entry:selected {
    margin: 0px 0px;
    border: none;
    border-radius: 15px;
    background-color: {{BLUE}};
}
