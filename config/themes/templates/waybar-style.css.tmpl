/* Generated by theme-switcher - {{THEME_NAME}} */

* {
    border: none;
    border-radius: 0px;
    font-family: "jetbrains mono nerd font";
    font-weight: bold;
    font-size: 11px;
    min-height: 0;
    transition: 0.3s;
}

window#waybar {
    background: rgba(21, 18, 27, 0.10);
    color: {{TEXT}};
}

tooltip {
    background: {{BASE}};
    color: {{TEXT}};
    border-radius: 10px;
    border-width: 1.5px;
    border-style: solid;
    border-color: {{SURFACE0}};
    transition: 0.3s;
}

#workspaces button {
    padding: 5px;
    color: {{SURFACE0}};
    margin-right: 5px;
}

#workspaces button.active {
    color: {{SUBTEXT0}};
}

#workspaces button.focused {
    color: {{SUBTEXT0}};
    background: {{MAROON}};
    border-radius: 20px;
}

#workspaces button.urgent {
    color: {{CRUST}};
    background: {{GREEN}};
    border-radius: 20px;
}

#workspaces button:hover {
    background: {{CRUST}};
    color: {{TEXT}};
    border-radius: 20px;
}

#custom-power_profile,
#custom-weather,
#custom-files,
#window,
#clock,
#battery,
#pulseaudio,
#wireplumber,
#network,
#bluetooth,
#temperature,
#workspaces,
#tray,
#backlight,
#cpu {
    background: {{BASE}};
    opacity: 0.8;
    padding: 0px 10px;
    margin: 0;
    margin-top: 5px;
    border: 1px solid {{MANTLE}};
}

#temperature {
    border-radius: 20px 0px 0px 20px;
}

#temperature.critical {
    color: {{MAROON}};
}

#backlight {
    border-radius: 20px 0px 0px 20px;
    border-right: 0px;
    padding-left: 7px;
}

#tray {
    border-radius: 20px;
    margin-right: 5px;
    padding: 0px 4px;
}

#workspaces {
    background: {{BASE}};
    border-radius: 20px;
    margin-left: 5px;
    padding-right: 0px;
    padding-left: 5px;
}

#custom-power_profile {
    color: {{GREEN}};
    border-left: 0px;
    border-right: 0px;
}

#window {
    border-radius: 20px;
    margin-left: 5px;
    margin-right: 5px;
}

#clock {
    color: {{PEACH}};
    border-radius: 20px;
    margin-left: 5px;
    border-right: 0px;
    transition: 0.3s;
    padding-left: 7px;
}

#network {
    color: {{YELLOW}};
    border-left: 0px;
    border-right: 0px;
}

#bluetooth {
    color: {{BLUE}};
    border-radius: 20px;
    margin-right: 10px
}

#pulseaudio,
#wireplumber {
    color: {{BLUE}};
    border-left: 0px;
    border-right: 0px;
}

#pulseaudio.microphone,
#wireplumber.microphone {
    color: {{MAUVE}};
    border-left: 0px;
    border-right: 0px;
    border-radius: 0px 20px 20px 0px;
    margin-right: 5px;
    padding-right: 8px;
}

#cpu {
    color: {{TEAL}};
    border-radius: 20px 0px 0px 20px;
    border-right: 0px;
}

#custom-files {
    color: {{PINK}};
    border-radius: 20px;
    margin-right: 5px;
}

#battery {
    color: {{GREEN}};
    border-radius: 0 20px 20px 0;
    margin-right: 5px;
    border-left: 0px;
    padding-right: 10px;
}

#custom-weather {
    color: {{YELLOW}};
    border-radius: 20px;
    margin-left: 5px;
}

#custom-nixos {
    background: {{BASE}};
    color: {{SKY}};
    border-radius: 20px;
    padding: 0px 10px;
    margin-left: 5px;
    margin-top: 5px;
    border: 1px solid {{MANTLE}};
    font-size: 20px;
}

#calendar {
    background: {{BASE}};
    color: {{TEXT}};
    border-radius: 10px;
    padding: 10px;
}

#calendar.header {
    color: {{TEXT}};
    font-weight: bold;
}

#calendar.weekdays {
    color: {{SUBTEXT0}};
}

#calendar.today {
    background: {{PEACH}};
    color: {{BASE}};
    border-radius: 5px;
    font-weight: bold;
}

#calendar.week {
    color: {{SUBTEXT0}};
}

#custom-power {
    background: {{BASE}};
    color: {{RED}};
    border-radius: 20px;
    padding: 0px 12px;
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    border: 1px solid {{MANTLE}};
    font-size: 14px;
}

#custom-power:hover {
    background: {{RED}};
    color: {{BASE}};
}

#custom-notification {
    background: {{BASE}};
    color: {{BLUE}};
    border-radius: 20px;
    padding: 0px 10px;
    margin-right: 5px;
    margin-top: 5px;
    border: 1px solid {{MANTLE}};
    font-size: 14px;
}

#custom-notification:hover {
    background: rgba(137, 180, 250, 0.2);
}
