(include "variables.yuck")
(include "host-config.yuck")

; Tray
(defwidget tray []
  (box
    :class "tray"
    :halign "end"
    :space-evenly false
    (eventbox
      :cursor "pointer"
      :onclick "scripts/qs-toggle"
      :visible {has-battery == "true"}
      (box
        :class "tray-item bat"
        :spacing 0
        :space-evenly false
        (image :class "icon bat-icon" :path bat-icon :image-height "26")
        (label :class "text bat-text" :text "${bat-num == '' ? '--' : bat-num}%")))
    (box
      :class "tray-item br"
      :visible {has-backlight == "true"}
      :spacing 0
      :space-evenly false
      (image :class "icon br-icon" :path "images/brightness.svg" :image-height "20")
      (label :class "text vol-text" :text "${br == '' ? '--' : br}%"))
    (eventbox
      :cursor "pointer"
      :onclick "scripts/media-toggle"
      :visible {media-status != "Stopped"}
      (box :class "tray-item media-toggle" :spacing 8 :space-evenly false
        (box :visible {media-art != ""}
          (image :class "media-tray-art" :path media-art :image-width 20 :image-height 20))
        (label :class "icon" :text "󰝚" :visible {media-art == ""})
        (label :class "text media-tray-title" :text media-title
               :ellipsize "end" :limit-width 22 :visible {media-title != ""})))
    (eventbox
      :cursor "pointer"
      :onclick "scripts/qs-toggle"
      (box :class "tray-item qs-toggle" :spacing 0 :space-evenly false
        (label :class "icon" :text "󰍜")))
    (box
      :class "tray-item"
      :spacing 0
      :space-evenly false
      (image :class "icon systray-icon" :path "images/tray.svg" :image-height "20")
      (systray
        :spacing 10
        :orientation "h"
        :space-evenly true
        :icon-size "20"))
    ))

; Media Player
(defwidget mediaplayer-popup []
  (box :class "media-popup" :orientation "v" :spacing 12 :space-evenly false
    (box :spacing 12 :space-evenly false
      (box :visible {media-art != ""}
        (image :class "media-art" :path media-art :image-width 80 :image-height 80))
      (box :class "media-art-placeholder" :visible {media-art == ""}
        (label :class "icon media-art-icon" :text "󰝚"))
      (box :class "media-info" :orientation "v" :spacing 4 :space-evenly false
           :valign "center" :hexpand true
        (label :class "media-title" :text media-title :halign "start"
               :ellipsize "end" :limit-width 28)
        (label :class "media-artist" :text media-artist :halign "start"
               :ellipsize "end" :limit-width 28 :visible {media-artist != ""})))
    (box :class "media-controls" :spacing 24 :halign "center" :space-evenly false
      (eventbox :cursor "pointer" :onclick "scripts/media prev"
        (label :class "media-btn" :text "󰒮"))
      (eventbox :cursor "pointer" :onclick "scripts/media toggle"
        (label :class "media-btn media-btn-play"
               :text {media-status == "Playing" ? "󰏤" : "󰐎"}))
      (eventbox :cursor "pointer" :onclick "scripts/media next"
        (label :class "media-btn" :text "󰒭")))))

(defwindow mediaplayer
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "mediaplayer"
  :geometry (geometry
    :x "10px"
    :y "40px"
    :width "340px"
    :height "0%"
    :anchor "top right")
  (mediaplayer-popup))

; Quick Settings
(defwidget qs-action [icon onclick ?tooltip]
  (eventbox :cursor "pointer" :onclick onclick :tooltip tooltip
    (box :class "qs-action"
      (image :path icon :image-width 18 :image-height 18))))

(defwidget qs-slider [icon value onchange]
  (box :class "qs-slider" :spacing 10 :space-evenly false
    (image :path icon :image-width 18 :image-height 18)
    (scale :hexpand true :orientation "h" :value value :min 0 :max 101
           :onchange onchange :flipped false)))

(defwidget qs-slider-cycle [icon value onchange cycleicon cycleonclick tooltip]
  (box :class "qs-slider" :spacing 10 :space-evenly false
    (image :path icon :image-width 18 :image-height 18)
    (scale :hexpand true :orientation "h" :value value :min 0 :max 101
           :onchange onchange :flipped false)
    (eventbox :cursor "pointer" :onclick cycleonclick :tooltip tooltip
      (box :class "qs-slider-cycle"
        (image :path cycleicon :image-width 14 :image-height 14)))))

(defwidget qs-pill [icon label sublabel active onclick ?onrightclick ?tooltip]
  (eventbox :cursor "pointer" :onclick onclick :onrightclick onrightclick
            :tooltip tooltip :hexpand true
    (box :class {active == "on" ? "qs-pill qs-pill-active" : "qs-pill"}
         :spacing 10 :space-evenly false :hexpand true
      (image :class "qs-pill-icon" :path icon :image-width 18 :image-height 18)
      (box :orientation "v" :spacing 0 :space-evenly false :hexpand true
        (label :class "qs-pill-title" :text label :halign "start")
        (label :class "qs-pill-sub"   :text sublabel :halign "start"
               :visible {sublabel != ""})))))

(defwidget qs-profile-btn [profile icon active ?tooltip]
  (eventbox :cursor "pointer" :tooltip tooltip
            :onclick "scripts/power-profile set ${profile}"
    (box :class {active ? "qs-profile-btn qs-profile-btn-active" : "qs-profile-btn"}
         :hexpand true :halign "fill"
      (image :path icon :image-width 16 :image-height 16))))

(defwidget quick-settings-panel []
  (box :class "qs-panel" :orientation "v" :spacing 14 :space-evenly false
    (box :spacing 10 :space-evenly false :valign "start"
      (box :class "qs-bat" :orientation "v" :spacing 6 :space-evenly false :hexpand true
        (box :spacing 6 :space-evenly false :halign "start"
          (image :path bat-icon :image-height 22)
          (label :class "qs-bat-text" :text "${bat-num == '' ? '--' : bat-num}%")
          (label :class "qs-bat-time" :text bat-remaining
                 :visible {bat-remaining != ""}))
        (box :class "qs-profile-row" :spacing 4 :space-evenly true
          (qs-profile-btn :profile "performance"
                          :icon "images/power-profile-performance.svg"
                          :active {power-profile == "performance"}
                          :tooltip "Performance")
          (qs-profile-btn :profile "balanced"
                          :icon "images/power-profile-balanced.svg"
                          :active {power-profile == "balanced"}
                          :tooltip "Balanced")
          (qs-profile-btn :profile "power-saver"
                          :icon "images/power-profile-saver.svg"
                          :active {power-profile == "power-saver"}
                          :tooltip "Power saver")))
      (qs-action :icon "images/lock.svg"     :tooltip "Lock screen"
                 :onclick "hyprlock & scripts/qs-toggle")
      (qs-action :icon "images/shutdown.svg" :tooltip "Power menu"
                 :onclick "scripts/qs-toggle; eww update center-option=powermenu reveal-option=powermenu"))
    (box :orientation "v" :spacing 2 :space-evenly false
      (qs-slider-cycle :icon "images/volume-high.svg" :value vol-num
                       :onchange "pamixer --set-volume {}"
                       :cycleicon "images/headphones.svg"
                       :cycleonclick "scripts/audio-sink cycle"
                       :tooltip "Switch audio output")
      (label :class "qs-audio-device" :halign "start"
             :text {sink-name == "" ? "Output: —" : "Output: ${sink-name}"}
             :limit-width 36))
    (box :orientation "v" :spacing 2 :space-evenly false
      (qs-slider-cycle :icon mic-icon :value {mic-num == "muted" ? 0 : mic-num}
                       :onchange "pamixer --default-source --set-volume {}"
                       :cycleicon "images/microphone.svg"
                       :cycleonclick "scripts/audio-source cycle"
                       :tooltip "Switch microphone input")
      (label :class "qs-audio-device" :halign "start"
             :text {source-name == "" ? "Input: —" : "Input: ${source-name}"}
             :limit-width 36))
    (box :visible {has-backlight == "true"}
      (qs-slider :icon "images/brightness.svg" :value br :onchange "scripts/brightness set {}"))
    (box :orientation "v" :spacing 8 :space-evenly false
      (box :spacing 8 :space-evenly true
        (qs-pill :icon wifi-icon              :label "Wi-Fi"     :sublabel wifi-ssid :active wifi-state
                 :onclick "scripts/wifi toggle"
                 :onrightclick "scripts/qs-toggle; kitty -e impala"
                 :tooltip "Toggle Wi-Fi (right-click: open Impala)")
        (qs-pill :icon "images/bluetooth.svg" :label "Bluetooth" :sublabel bt-device :active bt-state
                 :onclick "scripts/bluetooth toggle"
                 :onrightclick "scripts/qs-toggle; vicinae deeplink \"vicinae://extensions/bluetooth\""
                 :tooltip "Toggle Bluetooth (right-click: open Bluetooth manager)"))
      (box :class "qs-sysinfo" :spacing 20 :space-evenly true
        (box :spacing 6 :space-evenly false :tooltip "CPU usage"
          (label :class "icon" :text " ")
          (label :class "text" :text "CPU ${cpu}%"))
        (box :spacing 6 :space-evenly false :tooltip "RAM usage"
          (label :class "icon" :text " ")
          (label :class "text" :text "RAM ${ram}%"))))))

(defwindow quick-settings
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "quick-settings"
  :geometry (geometry
    :x "10px"
    :y "40px"
    :width "340px"
    :height "0%"
    :anchor "top right")
  (quick-settings-panel))

(defwindow qs-overlay
  :stacking "fg"
  :monitor "0"
  :exclusive false
  :focusable false
  :namespace "qs-overlay"
  :geometry (geometry
    :x "0"
    :y "0"
    :width "100%"
    :height "100%"
    :anchor "top left")
  (eventbox :cursor "default" :onclick "scripts/qs-toggle"
    (box :class "qs-overlay-catcher" :hexpand true :vexpand true)))

; Workspaces
(defwidget workspaces []
  (box
    :class "workspaces"
    :halign "center"
    :hexpand false
    (literal :content numworkspaces)))

(defwidget time []
  (box
    :class "time"
    :space-evenly false
    :spacing 0
    (label :class "text" :text "")
    (image :class "icon clock-icon" :path "images/clock.svg" :image-width "20" :image-height "20")
    (label :class "text" :text time)))

(defwidget date []
  (eventbox
    :cursor "pointer"
    :tooltip "Open/close notification center"
    :onclick "scripts/toggle-notif-center"
    (box
      :class "date"
      :halign "start"
      :spacing 0
      :space-evenly false
      (image :class "icon date-icon" :path "images/calendar.svg" :image-width "20" :image-height "20")
      (label :class "text" :text date))))

(defwidget nix-launcher []
  (eventbox :cursor "pointer" :tooltip "Open Vicinae" :onclick "vicinae toggle"
    (box :class "nix-launcher" :spacing 0 :space-evenly false
      (label :class "nix-logo" :text ""))))

(defwidget left []
  (box
    :class "left"
    :halign "start"
    :space-evenly false
    :spacing 0
    (nix-launcher)
    (workspaces)))

(defwidget lock []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 1 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=1 power-reveal=1"}
    (box
      :class {power-option == 1 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 1 ? "images/lock-selected.svg" : "images/lock.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 1 ? true : false}
        :duration "250ms"
      (label :text "Lock")))))

(defwidget suspend []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 2 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=2 power-reveal=2"}
    (box
      :class {power-option == 2 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 2 ? "images/suspend-selected.svg" : "images/suspend.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 2 ? true : false}
        :duration "250ms"
      (label :text "Suspend")))))

(defwidget logout []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 3 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=3 power-reveal=3"}
    (box
      :class {power-option == 3 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 3 ? "images/logout-selected.svg" : "images/logout.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 3 ? true : false}
        :duration "250ms"
      (label :text "Logout")))))

(defwidget reboot []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 4 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=4 power-reveal=4"}
    (box
      :class {power-option == 4 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 4 ? "images/reboot-selected.svg" : "images/reboot.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 4 ? true : false}
        :duration "250ms"
      (label :text "Reboot")))))

(defwidget shutdown []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 5 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=5 power-reveal=5"}
    (box
      :class {power-option == 5 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 5 ? "images/shutdown-selected.svg" : "images/shutdown.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 5 ? true : false}
        :duration "250ms"
      (label :text "Shutdown")))))

(defwidget powermenu []
  (box
    :class "powermenu"
    :spacing 25
    :space-evenly false
    :orientation "h"
    (lock)
    (suspend)
    (logout)
    (reboot)
    (shutdown)))

(defwidget fullscreen []
  (eventbox
    :cursor "pointer"
    :onclick {screenshot-option == 1 ? "scripts/screenshooter; eww update screenshot-option=1 screenshot-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update screenshot-option=1 screenshot-reveal=1"}
    (box
      :class {screenshot-option == 1 ? "ss-active ss-widget" : "ss-inactive ss-widget"}
      :spacing 10
      :space-evenly false
      :orientation "h"
      (image :path {screenshot-option == 1 ? "images/screenshot-selected.svg" : "images/screenshot.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {screenshot-reveal == 1 ? true : false}
        :duration "250ms"
        (label :text "Fullscreen")))))

(defwidget delay []
  (eventbox
    :cursor "pointer"
    :onclick {screenshot-option == 2 ? "scripts/screenshooter; eww update screenshot-option=1 screenshot-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update screenshot-option=2 screenshot-reveal=2"}
    (box
      :class {screenshot-option == 2 ? "ss-active ss-widget" : "ss-inactive ss-widget"}
      :spacing 10
      :space-evenly false
      :orientation "h"
      (image :path {screenshot-option == 2 ? "images/alarm-selected.svg" : "images/alarm.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {screenshot-reveal == 2 ? true : false}
        :duration "250ms"
        (label :text "3s")))))

(defwidget region []
  (eventbox
    :cursor "pointer"
    :onclick {screenshot-option == 3 ? "scripts/screenshooter; eww update screenshot-option=1 screenshot-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update screenshot-option=3 screenshot-reveal=3"}
    (box
      :class {screenshot-option == 3 ? "ss-active ss-widget" : "ss-inactive ss-widget"}
      :spacing 10
      :space-evenly false
      :orientation "h"
      (image :path {screenshot-option == 3 ? "images/crop-selected.svg" : "images/crop.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {screenshot-reveal == 3 ? true : false}
        :duration "250ms"
        (label :text "Region")))))

(defwidget screenshooter []
  (box
    :class "screenshooter"
    :spacing 25
    :space-evenly false
    :orientation "h"
    (fullscreen)
    (delay)
    (region)))

(defwidget center []
  (box
    :spacing 0
    :space-evenly false
    (box
      :visible {center-option == "screenshooter" ? true : false}
      (revealer
        :transition "crossfade"
        :reveal {reveal-option == "screenshooter" ? true : false}
        :duration "500ms"
        (screenshooter)))
    (box
      :visible {center-option == "workspaces" ? true : false}
      (box
        :space-evenly false
        :spacing 0
        (time)
        (date)))
    (box
      :visible {center-option == "powermenu" ? true : false}
      (revealer
        :transition "crossfade"
        :reveal {reveal-option == "powermenu" ? true : false}
        :duration "500ms"
        (powermenu)))))

; Notification Center
(defwidget notif-history-pane []
  (box :class "notif-history-pane" :orientation "v" :spacing 10 :space-evenly false
    (box :space-evenly false :spacing 0
      (label :class "notif-history-title" :text "Notifications" :hexpand true :halign "start")
      (eventbox :cursor "pointer" :onclick "scripts/clear-notifications"
        (label :class "notif-clear-btn" :text "Clear" :visible {notif-history != "[]"})))
    (box :class "notif-empty-state" :orientation "v" :valign "center" :vexpand true
         :visible {notif-history == "[]"}
      (label :class "notif-empty-icon" :text "")
      (label :class "notif-empty-text" :text "No notifications"))
    (scroll :vscroll true :vexpand true :visible {notif-history != "[]"}
      (box :orientation "v" :spacing 6 :space-evenly false
        (for item in notif-history
          (eventbox :cursor "pointer"
                    :tooltip "Click to open source app"
                    :onclick "scripts/notification-open ${item.id}; scripts/dismiss-from-history ${item.id}"
            (box :class "notif-item" :spacing 8 :space-evenly false :hexpand true
              (box :visible {item.icon != ""}
                (image :class "notif-icon" :path {item.icon} :image-width 28 :image-height 28))
              (box :class "notif-item-content" :orientation "v" :spacing 2 :space-evenly false :hexpand true
                (label :class "notif-summary" :text {item.summary} :halign "start"
                       :ellipsize "end" :limit-width 24)
                (label :class "notif-body" :text {item.body} :halign "start"
                       :ellipsize "end" :limit-width 28 :visible {item.body != ""}))
              (eventbox :cursor "pointer" :onclick "scripts/dismiss-from-history ${item.id}"
                (label :class "notif-dismiss" :text "")))))))))

(defwidget notif-calendar-pane []
  (box :class "notif-calendar-pane" :orientation "v" :spacing 8 :space-evenly false
    (label :class "notif-cal-day"  :text date-day  :halign "start")
    (label :class "notif-cal-date" :text date-full :halign "start")
    (calendar
      :show-details false
      :show-day-names true
      :show-heading true
      :show-week-numbers false)))

(defwidget notif-center-panel []
  (box :class "notif-center" :spacing 0 :space-evenly false
    (notif-history-pane)
    (box :class "notif-center-sep")
    (notif-calendar-pane)))

(defwindow notif-center
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "notif-center"
  :geometry (geometry
    :x "0px"
    :y "40px"
    :width "640px"
    :height "420px"
    :anchor "top center")
  (notif-center-panel))

(defwidget bar []
  (centerbox
    :orientation "h"
    :class "bar"
    (left)
    (center)
    (tray)))

(defwindow bar
  :stacking "bg"
  :monitor "0"
  :exclusive true
  :namespace "bar"
  :geometry (geometry
    :x "0px"
    :y "0%"
    :width "100%"
    :height "0%"
    :anchor "top center")
  (bar))

(defwidget corners []
  (box
    :class "corners-box"
    (box
      :class "corners-left"
      :hexpand false
      :halign "start")
    (box
      :class "corners-right"
      :hexpand false
      :halign "end")))

(defwidget corners-alt []
  (box
    :class "corners-box-alt"
    (box
      :class "corners-left-alt"
      :hexpand false
      :halign "start")
    (box
      :class "corners-right-alt"
      :hexpand false
      :halign "end")))

(defwindow corners
  :stacking "bg"
  :monitor "0"
  :exclusive false
  :namespace "corners"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "0%"
    :anchor "top center")
  (corners))

(defwindow corners_alt
  :stacking "bg"
  :monitor "0"
  :exclusive false
  :namespace "corners"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "0%"
    :anchor "bottom center")
  (corners-alt))

; OSD
(defwidget volume-osd []
  (box
    :class "osd volume-osd"
    :spacing 0
    :space-evenly false
    :orientation "h"
    :hexpand true
    (image :class "osd-icon" :path vol-icon :image-height "45")
    (scale
      :flipped false
      :orientation "h"
      :value vol-num
      :draw-value true
      :min 0
      :max 101
    )
  )
)

(defwindow volume_osd
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "volume-osd"
  :geometry (geometry
    :x "0px"
    :y "5%"
    :width "15%"
    :height "5%"
    :anchor "bottom center"
  )
  (volume-osd)
)

(defwidget brightness-osd []
  (box
    :class "osd brightness-osd"
    :spacing 0
    :space-evenly false
    :orientation "h"
    :hexpand true
    (image :class "osd-icon" :path "images/brightness.svg" :image-height "45")
    (scale
      :flipped false
      :orientation "h"
      :value br
      :draw-value true
      :min 0
      :max 101
    )
  )
)

(defwindow brightness_osd
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "brightness-osd"
  :geometry (geometry
    :x "0px"
    :y "5%"
    :width "15%"
    :height "5%"
    :anchor "bottom center"
  )
  (brightness-osd)
)

; Notification
(defwidget notification-popup []
  (eventbox :cursor "pointer"
            :tooltip "Clique para abrir o app emissor"
            :onclick "scripts/notification-open ${notif.id}; scripts/dismiss-notification ${notif.id}"
    (box :class "notif-popup" :orientation "v" :spacing 6 :space-evenly false
      :visible {notif != "{}"}
      (box :spacing 10 :space-evenly false
        (box :visible {notif.icon != ""}
          (image :class "notif-icon" :path {notif.icon} :image-width 32 :image-height 32))
        (box :orientation "v" :spacing 2 :space-evenly false
          (label :class "notif-summary" :text {notif.summary} :halign "start"
                 :ellipsize "end" :limit-width 36)
          (label :class "notif-body" :text {notif.body} :halign "start"
                 :ellipsize "end" :limit-width 40 :visible {notif.body != ""}))))))

(defwindow notification
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "notification"
  :geometry (geometry
    :x "0px"
    :y "40px"
    :width "360px"
    :height "0%"
    :anchor "top center")
  (notification-popup))
