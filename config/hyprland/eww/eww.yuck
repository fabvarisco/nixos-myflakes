(defpoll clock :interval "1s"
  `date '+%H:%M'`)

(defpoll date-str :interval "60s"
  `date '+%d/%m/%Y'`)

(defpoll cpu-usage :interval "3s"
  `top -bn1 | grep "Cpu(s)" | awk '{print int($2)}'`)

(defpoll volume :interval "2s"
  `pamixer --get-volume 2>/dev/null || echo "0"`)

(defpoll battery :interval "30s"
  `cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1 || echo ""`)

(deflisten workspaces :initial "[]"
  `hyprctl workspaces -j | jq '[.[] | {id:.id}] | sort_by(.id)'`)

(deflisten active-ws :initial 1
  `socat -u UNIX-CONNECT:/tmp/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | stdbuf -o0 grep 'workspace>>' | stdbuf -o0 sed 's/workspace>>//' | stdbuf -o0 tr -d '\n'`)

(deflisten active-window :initial ""
  `socat -u UNIX-CONNECT:/tmp/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock - | stdbuf -o0 grep 'activewindowtitle>>' | stdbuf -o0 sed 's/activewindowtitle>>//'`)

(defwidget workspaces []
  (box :class "workspaces" :spacing 4 :halign "start"
    (for ws in workspaces
      (button
        :class {ws.id == active-ws ? "ws-btn active" : "ws-btn"}
        :onclick "hyprctl dispatch workspace ${ws.id}"
        "${ws.id}"))))

(defwidget left []
  (box :halign "start" :spacing 8
    (workspaces)
    (label :class "window-title" :text active-window :truncate true :limit-width 40)))

(defwidget center []
  (box :halign "center" :spacing 10
    (label :class "clock" :text clock)
    (label :class "date-label" :text date-str)))

(defwidget right []
  (box :halign "end" :spacing 14
    (label :class "cpu" :text "  ${cpu-usage}%")
    (label :class "vol" :text "  ${volume}%")
    (label :class "bat" :visible {battery != ""} :text "  ${battery}%")))

(defwidget bar-widget []
  (centerbox :class "bar"
    (left)
    (center)
    (right)))

(defwindow bar
  :monitor 0
  :geometry (geometry :x 0 :y 0 :width "100%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  (bar-widget))
