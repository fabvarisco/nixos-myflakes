(include "variables.yuck")

; Tray
(defwidget tray []
  (box
    :class "tray"
    :halign "end"
    :space-evenly false
    (eventbox
      :cursor "pointer"
      :onclick "scripts/qs-toggle"
      (box
        :class "tray-item wifi"
        :spacing 0
        :space-evenly false
        (image :class "icon wifi-icon" :path wifi-icon :image-height "20")
        (label :class "text wifi-text" :text wifi-strength)))
    (eventbox
      :cursor "pointer"
      :onclick "scripts/qs-toggle"
      (box
        :class "tray-item vol"
        :spacing 0
        :space-evenly false
        (image :class "icon vol-icon" :path vol-icon :image-height "20")
        (label :class "text vol-text" :text "${vol-num == '' ? '--' : vol-num == 'muted' ? 'muted' : vol-num + '%'}")))
    (eventbox
      :cursor "pointer"
      :onclick "scripts/qs-toggle"
      :visible {has-battery == "true"}
      (box
        :class "tray-item bat"
        :spacing 0
        :space-evenly false
        (image :class "icon bat-icon" :path bat-icon :image-height "26")
        (label :class "text bat-text" :text "${bat-num == '' ? '--' : bat-num}%")))
    (box
      :class "tray-item br"
      :spacing 0
      :space-evenly false
      (image :class "icon br-icon" :path "images/brightness.svg" :image-height "20")
      (label :class "text vol-text" :text "${br == '' ? '--' : br}%"))
    (box
      :class "tray-item ram"
      :spacing 0
      :space-evenly false
      (label :class "icon ram-icon" :text " ")
      (label :class "text ram-text" :text "${ram}%"))
    (box
      :class "tray-item cpu"
      :spacing 0
      :space-evenly false
      (label :class "icon cpu-icon" :text " ")
      (label :class "text cpu-text" :text "${cpu}%"))
    (box
      :class "tray-item"
      :spacing 0
      :space-evenly false
      (image :class "icon systray-icon" :path "images/tray.svg" :image-height "20")
      (systray
        :spacing 10
        :orientation "h"
        :space-evenly true
        :icon-size "20"))
    (eventbox
      :cursor "pointer"
      :onclick "bash -c 'opt=$(eww get center-option); if [ \"$opt\" = \"powermenu\" ]; then eww update center-option=workspaces reveal-option=workspaces power-reveal=0; else eww update center-option=powermenu reveal-option=powermenu; fi'"
      (box
        :class "tray-item pwr-toggle"
        :spacing 0
        :space-evenly false
        (image :class "icon" :path "images/shutdown.svg" :image-height "20")))
    ))

; Calendar popup
(defwidget calendar-popup []
  (box
    :class "calendar-popup"
    :orientation "v"
    (calendar
      :show-details false
      :show-day-names true
      :show-heading true
      :show-week-numbers false)))

(defwindow calendar
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "calendar"
  :geometry (geometry
    :x "10px"
    :y "40px"
    :width "230px"
    :height "0%"
    :anchor "top left")
  (calendar-popup))

; Quick Settings
(defwidget qs-action [icon onclick]
  (eventbox :cursor "pointer" :onclick onclick
    (box :class "qs-action"
      (image :path icon :image-width 18 :image-height 18))))

(defwidget qs-slider [icon value onchange]
  (box :class "qs-slider" :spacing 10 :space-evenly false
    (image :path icon :image-width 18 :image-height 18)
    (scale :hexpand true :orientation "h" :value value :min 0 :max 101
           :onchange onchange :flipped false)))

(defwidget qs-slider-with-cycle [icon value onchange onclick-icon cycle-label cycle-onclick]
  (box :class "qs-slider" :spacing 10 :space-evenly false
    (eventbox :cursor "pointer" :onclick onclick-icon
      (image :path icon :image-width 18 :image-height 18))
    (scale :hexpand true :orientation "h" :value value :min 0 :max 101
           :onchange onchange :flipped false)
    (eventbox :cursor "pointer" :onclick cycle-onclick
      (box :class "qs-cycle" :spacing 4 :space-evenly false
        (label :class "qs-cycle-text" :text {cycle-label == "" ? "—" : cycle-label})
        (label :class "qs-cycle-arrow" :text "›")))))

(defwidget qs-pill [icon label sublabel active onclick]
  (eventbox :cursor "pointer" :onclick onclick :hexpand true
    (box :class {active == "on" ? "qs-pill qs-pill-active" : "qs-pill"}
         :spacing 10 :space-evenly false :hexpand true
      (image :class "qs-pill-icon" :path icon :image-width 18 :image-height 18)
      (box :orientation "v" :spacing 0 :space-evenly false :hexpand true
        (label :class "qs-pill-title" :text label :halign "start")
        (label :class "qs-pill-sub"   :text sublabel :halign "start"
               :visible {sublabel != ""})))))

(defwidget qs-footer-btn [icon label onclick]
  (eventbox :cursor "pointer" :onclick onclick :hexpand true
    (box :class "qs-footer-btn" :orientation "v" :spacing 2 :space-evenly false
      (image :path icon :image-width 18 :image-height 18)
      (label :class "qs-footer-label" :text label))))

(defwidget quick-settings-panel []
  (box :class "qs-panel" :orientation "v" :spacing 14 :space-evenly false
    ; Linha 1: bateria (se houver) + power profile + ações rápidas
    (box :spacing 10 :space-evenly false
      (box :class "qs-bat" :spacing 6 :space-evenly false :hexpand true :halign "start"
           :visible {has-battery == "true"}
        (image :path bat-icon :image-height 22)
        (label :class "qs-bat-text" :text "${bat-num == '' ? '--' : bat-num}%"))
      (eventbox :cursor "pointer" :onclick "scripts/power-profile cycle"
        (box :class "qs-profile-pill qs-profile-${power-profile}"
             :spacing 6 :space-evenly false
          (image :path power-profile-icon :image-width 16 :image-height 16)
          (label :class "qs-profile-text" :text power-profile-label)))
      (qs-action :icon "images/lock.svg"     :onclick "scripts/qs-toggle; hyprlock")
      (qs-action :icon "images/shutdown.svg" :onclick "scripts/qs-toggle; eww update center-option=powermenu reveal-option=powermenu"))
    ; Volume + seletor de saída
    (qs-slider-with-cycle
      :icon vol-icon
      :value vol-num
      :onchange "pamixer --set-volume {}"
      :onclick-icon "pamixer -t"
      :cycle-label sink-name
      :cycle-onclick "scripts/audio-sink cycle")
    ; Microfone + seletor de entrada
    (qs-slider-with-cycle
      :icon mic-icon
      :value mic-num
      :onchange "scripts/mic set {}"
      :onclick-icon "scripts/mic toggle"
      :cycle-label source-name
      :cycle-onclick "scripts/audio-source cycle")
    ; Brilho (só notebook)
    (box :visible {has-battery == "true"}
      (qs-slider :icon "images/brightness.svg"  :value br :onchange "scripts/brightness set {}"))
    ; Pills 2x2
    (box :orientation "v" :spacing 8 :space-evenly false
      (box :spacing 8 :space-evenly true
        (qs-pill
          :icon {net-mode == "ethernet" ? "images/ethernet.svg" : wifi-icon}
          :label {net-mode == "ethernet" ? "Ethernet" : "Wi-Fi"}
          :sublabel {net-mode == "ethernet" ? "Connected" : wifi-ssid}
          :active {net-mode == "off" ? "off" : "on"}
          :onclick "scripts/wifi toggle")
        (qs-pill :icon "images/bluetooth.svg"    :label "Bluetooth"   :sublabel bt-device :active bt-state    :onclick "scripts/bluetooth toggle"))
      (box :spacing 8 :space-evenly true
        (qs-pill :icon "images/night-light.svg"  :label "Night Light" :sublabel ""        :active night-light :onclick "scripts/night-light toggle")
        (qs-pill :icon "images/airplane.svg"     :label "Airplane"    :sublabel ""        :active airplane    :onclick "scripts/airplane toggle")))
    ; Métricas
    (box :class "qs-metrics" :spacing 16 :space-evenly false :halign "center"
      (label :text "CPU ${cpu}%")
      (label :text "RAM ${ram}%"))
    ; Footer power menu
    (box :class "qs-footer" :spacing 6 :space-evenly true
      (qs-footer-btn :icon "images/lock.svg"     :label "Lock"     :onclick "scripts/qs-toggle; hyprlock")
      (qs-footer-btn :icon "images/logout.svg"   :label "Logout"   :onclick "scripts/qs-toggle; pkill Hyprland")
      (qs-footer-btn :icon "images/reboot.svg"   :label "Reboot"   :onclick "scripts/qs-toggle; reboot")
      (qs-footer-btn :icon "images/shutdown.svg" :label "Shutdown" :onclick "scripts/qs-toggle; shutdown -f now"))))

(defwindow quick-settings
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "quick-settings"
  :geometry (geometry
    :x "10px"
    :y "40px"
    :width "380px"
    :height "0%"
    :anchor "top right")
  (quick-settings-panel))

; Workspaces
(defwidget workspaces []
  (box
    :class "workspaces"
    :halign "center"
    :hexpand false
    (literal :content numworkspaces)))

(defwidget time []
  (box
    :class "time"
    :space-evenly false
    :spacing 0
    (label :class "text" :text "")
    (image :class "icon clock-icon" :path "images/clock.svg" :image-width "20" :image-height "20")
    (label :class "text" :text time)))

(defwidget date []
  (eventbox
    :cursor "pointer"
    :onclick "bash scripts/toggle-calendar"
    (box
      :class "date"
      :spacing 0
      :space-evenly false
      (image :class "icon date-icon" :path "images/calendar.svg" :image-width "20" :image-height "20")
      (label :class "text" :text date))))

(defwidget left []
  (box
    :class "left"
    :halign "start"
    :space-evenly false
    :spacing 0
    (workspaces)))

(defwidget clock []
  (box
    :class "clock"
    :halign "center"
    :space-evenly false
    :spacing 0
    (time)
    (date)))

(defwidget lock []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 1 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=1 power-reveal=1"}
    (box
      :class {power-option == 1 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 1 ? "images/lock-selected.svg" : "images/lock.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 1 ? true : false}
        :duration "250ms"
      (label :text "Lock")))))

(defwidget suspend []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 2 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=2 power-reveal=2"}
    (box
      :class {power-option == 2 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 2 ? "images/suspend-selected.svg" : "images/suspend.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 2 ? true : false}
        :duration "250ms"
      (label :text "Suspend")))))

(defwidget logout []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 3 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=3 power-reveal=3"}
    (box
      :class {power-option == 3 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 3 ? "images/logout-selected.svg" : "images/logout.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 3 ? true : false}
        :duration "250ms"
      (label :text "Logout")))))

(defwidget reboot []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 4 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=4 power-reveal=4"}
    (box
      :class {power-option == 4 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 4 ? "images/reboot-selected.svg" : "images/reboot.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 4 ? true : false}
        :duration "250ms"
      (label :text "Reboot")))))

(defwidget shutdown []
  (eventbox
    :cursor "pointer"
    :onclick {power-option == 5 ? "scripts/powermenu; eww update power-option=1 power-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update power-option=5 power-reveal=5"}
    (box
      :class {power-option == 5 ? "pwr-active pwr-widget" : "pwr-inactive pwr-widget"}
      :orientation "h"
      :spacing 10
      :space-evenly false
      (image :path {power-option == 5 ? "images/shutdown-selected.svg" : "images/shutdown.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {power-reveal == 5 ? true : false}
        :duration "250ms"
      (label :text "Shutdown")))))

(defwidget powermenu []
  (box
    :class "powermenu"
    :spacing 25
    :space-evenly false
    :orientation "h"
    (lock)
    (suspend)
    (logout)
    (reboot)
    (shutdown)))

(defwidget fullscreen []
  (eventbox
    :cursor "pointer"
    :onclick {screenshot-option == 1 ? "scripts/screenshooter; eww update screenshot-option=1 screenshot-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update screenshot-option=1 screenshot-reveal=1"}
    (box
      :class {screenshot-option == 1 ? "ss-active ss-widget" : "ss-inactive ss-widget"}
      :spacing 10
      :space-evenly false
      :orientation "h"
      (image :path {screenshot-option == 1 ? "images/screenshot-selected.svg" : "images/screenshot.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {screenshot-reveal == 1 ? true : false}
        :duration "250ms"
        (label :text "Fullscreen")))))

(defwidget delay []
  (eventbox
    :cursor "pointer"
    :onclick {screenshot-option == 2 ? "scripts/screenshooter; eww update screenshot-option=1 screenshot-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update screenshot-option=2 screenshot-reveal=2"}
    (box
      :class {screenshot-option == 2 ? "ss-active ss-widget" : "ss-inactive ss-widget"}
      :spacing 10
      :space-evenly false
      :orientation "h"
      (image :path {screenshot-option == 2 ? "images/alarm-selected.svg" : "images/alarm.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {screenshot-reveal == 2 ? true : false}
        :duration "250ms"
        (label :text "3s")))))

(defwidget region []
  (eventbox
    :cursor "pointer"
    :onclick {screenshot-option == 3 ? "scripts/screenshooter; eww update screenshot-option=1 screenshot-reveal=0 center-option=workspaces reveal-option=workspaces" : "eww update screenshot-option=3 screenshot-reveal=3"}
    (box
      :class {screenshot-option == 3 ? "ss-active ss-widget" : "ss-inactive ss-widget"}
      :spacing 10
      :space-evenly false
      :orientation "h"
      (image :path {screenshot-option == 3 ? "images/crop-selected.svg" : "images/crop.svg"} :image-width 20 :image-height 20)
      (revealer
        :transition "slideright"
        :reveal {screenshot-reveal == 3 ? true : false}
        :duration "250ms"
        (label :text "Region")))))

(defwidget screenshooter []
  (box
    :class "screenshooter"
    :spacing 25
    :space-evenly false
    :orientation "h"
    (fullscreen)
    (delay)
    (region)))

(defwidget center []
  (box
    :spacing 0
    :space-evenly false
    (box
      :visible {center-option == "screenshooter" ? true : false}
      (revealer
        :transition "crossfade"
        :reveal {reveal-option == "screenshooter" ? true : false}
        :duration "500ms"
        (screenshooter)))
    (box
      :visible {center-option == "workspaces" ? true : false}
      (clock))
    (box
      :visible {center-option == "powermenu" ? true : false}
      (revealer
        :transition "crossfade"
        :reveal {reveal-option == "powermenu" ? true : false}
        :duration "500ms"
        (powermenu)))))

(defwidget bar []
  (centerbox
    :orientation "h"
    :class "bar"
    (left)
    (center)
    (tray)))

(defwindow bar
  :stacking "bg"
  :monitor "0"
  :exclusive true
  :namespace "bar"
  :geometry (geometry
    :x "0px"
    :y "0%"
    :width "100%"
    :height "0%"
    :anchor "top center")
  (bar))

(defwidget corners []
  (box
    :class "corners-box"
    (box
      :class "corners-left"
      :hexpand false
      :halign "start")
    (box
      :class "corners-right"
      :hexpand false
      :halign "end")))

(defwidget corners-alt []
  (box
    :class "corners-box-alt"
    (box
      :class "corners-left-alt"
      :hexpand false
      :halign "start")
    (box
      :class "corners-right-alt"
      :hexpand false
      :halign "end")))

(defwindow corners
  :stacking "bg"
  :monitor "0"
  :exclusive false
  :namespace "corners"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "0%"
    :anchor "top center")
  (corners))

(defwindow corners_alt
  :stacking "bg"
  :monitor "0"
  :exclusive false
  :namespace "corners"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "0%"
    :anchor "bottom center")
  (corners-alt))

; OSD
(defwidget volume-osd []
  (box
    :class "osd volume-osd"
    :spacing 0
    :space-evenly false
    :orientation "h"
    :hexpand true
    (image :class "osd-icon" :path vol-icon :image-height "45")
    (scale
      :flipped false
      :orientation "h"
      :value vol-num
      :draw-value true
      :min 0
      :max 101
    )
  )
)

(defwindow volume_osd
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "volume-osd"
  :geometry (geometry
    :x "0px"
    :y "5%"
    :width "15%"
    :height "5%"
    :anchor "bottom center"
  )
  (volume-osd)
)

(defwidget brightness-osd []
  (box
    :class "osd brightness-osd"
    :spacing 0
    :space-evenly false
    :orientation "h"
    :hexpand true
    (image :class "osd-icon" :path "images/brightness.svg" :image-height "45")
    (scale
      :flipped false
      :orientation "h"
      :value br
      :draw-value true
      :min 0
      :max 101
    )
  )
)

(defwindow brightness_osd
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "brightness-osd"
  :geometry (geometry
    :x "0px"
    :y "5%"
    :width "15%"
    :height "5%"
    :anchor "bottom center"
  )
  (brightness-osd)
)

; Notification popup (top center)
(defwidget notification-card []
  (revealer
    :transition "slidedown"
    :duration "200ms"
    :reveal {notif != "" && notif != "{}"}
    (box :class "notification notification-${jq(notif, '.urgency // \"normal\"')}"
         :orientation "h"
         :spacing 12
         :space-evenly false
      (image :class "notification-icon"
             :path {jq(notif, '.icon // ""')}
             :image-width 48 :image-height 48
             :visible {jq(notif, '.icon // ""') != ""})
      (box :orientation "v"
           :spacing 2
           :space-evenly false
           :hexpand true
        (label :class "notification-summary"
               :text {jq(notif, '.summary // ""')}
               :halign "start"
               :limit-width 60
               :wrap true)
        (label :class "notification-body"
               :text {jq(notif, '.body // ""')}
               :halign "start"
               :limit-width 60
               :wrap true
               :visible {jq(notif, '.body // ""') != ""}))
      (eventbox :cursor "pointer"
        :onclick "dbus-send --session --dest=org.freedesktop.Notifications --type=method_call /org/freedesktop/Notifications org.freedesktop.Notifications.CloseNotification uint32:${jq(notif, '.id // 0')}"
        (label :class "notification-close" :text "✕")))))

(defwindow notification
  :stacking "overlay"
  :monitor "0"
  :exclusive false
  :namespace "notification"
  :geometry (geometry
    :x "0px"
    :y "12px"
    :width "440px"
    :height "0%"
    :anchor "top center")
  (notification-card))
