#!/usr/bin/env bash
# Manage power profile via power-profiles-daemon.
# Profiles: performance | balanced | power-saver

current() {
  powerprofilesctl get 2>/dev/null || echo balanced
}

set_profile() {
  [[ -n "$1" ]] || return
  powerprofilesctl set "$1" >/dev/null 2>&1
}

cycle() {
  case "$(current)" in
    performance) set_profile balanced ;;
    balanced)    set_profile power-saver ;;
    *)           set_profile performance ;;
  esac
}

label() {
  case "$(current)" in
    performance) echo Performance ;;
    power-saver) echo Saver ;;
    *)           echo Balanced ;;
  esac
}

icon() {
  case "$(current)" in
    performance) echo "images/power-profile-performance.svg" ;;
    power-saver) echo "images/power-profile-saver.svg" ;;
    *)           echo "images/power-profile-balanced.svg" ;;
  esac
}

case "$1" in
  current) current ;;
  label)   label ;;
  icon)    icon ;;
  cycle)   cycle ;;
  set)     set_profile "$2" ;;
esac
