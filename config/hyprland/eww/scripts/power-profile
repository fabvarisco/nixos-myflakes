#!/usr/bin/env bash
# Manage system power profile via the kernel platform_profile sysfs interface.
# Profiles on ThinkPad: performance | balanced | low-power

PROFILE_FILE=/sys/firmware/acpi/platform_profile

current() {
  [[ -r $PROFILE_FILE ]] && cat "$PROFILE_FILE" || echo balanced
}

set_profile() {
  [[ -n "$1" ]] || return
  if [[ -w $PROFILE_FILE ]]; then
    echo "$1" | tee "$PROFILE_FILE" >/dev/null 2>&1
  else
    echo "$1" | sudo -n tee "$PROFILE_FILE" >/dev/null 2>&1
  fi
}

cycle() {
  case "$(current)" in
    performance) set_profile balanced ;;
    balanced)    set_profile low-power ;;
    *)           set_profile performance ;;
  esac
}

label() {
  case "$(current)" in
    performance) echo Performance ;;
    low-power)   echo Saver ;;
    *)           echo Balanced ;;
  esac
}

icon() {
  case "$(current)" in
    performance) echo "images/power-profile-performance.svg" ;;
    low-power)   echo "images/power-profile-saver.svg" ;;
    *)           echo "images/power-profile-balanced.svg" ;;
  esac
}

case "$1" in
  current) current ;;
  label)   label ;;
  icon)    icon ;;
  cycle)   cycle ;;
  set)     set_profile "$2" ;;
esac
