#!/usr/bin/env bash

iface() {
  ls /sys/class/net 2>/dev/null | grep -E '^wl' | head -n1
}

strength=`iwconfig 2>/dev/null | grep "Link Quality=" | awk -F'=' '{ print $2 }' | awk -F'/' '{ print $1 }'`
wf=`echo "${strength:-0}*100/70" | bc 2>/dev/null || echo 0`

icon() {
  if [[ $wf -eq 0 ]]; then
    echo "images/wifi-off.svg"
  elif [[ $wf -le 30 ]]; then
    echo "images/wifi-low.svg"
  elif [[ $wf -le 60 ]]; then
    echo "images/wifi-medium.svg"
  elif [[ $wf -gt 60 ]]; then
    echo "images/wifi-high.svg"
  else
    echo "images/wifi-off.svg"
  fi
}

percentage() {
  if [[ $wf -ge 0 ]]; then
    echo "$wf%"
  else
    echo "Disconnected"
  fi
}

ssid() {
  iwconfig 2>/dev/null | grep ESSID | awk -F'ESSID:' '{print $2}' | tr -d '"' | xargs
}

state() {
  local i; i=$(iface)
  [[ -z "$i" ]] && { echo off; return; }
  if [[ "$(cat /sys/class/net/$i/operstate 2>/dev/null)" == "up" ]] \
     || iwconfig "$i" 2>/dev/null | grep -q "ESSID:\"."; then
    echo on
  else
    echo off
  fi
}

toggle() {
  local i; i=$(iface)
  [[ -z "$i" ]] && exit 0
  if [[ "$(state)" == "on" ]]; then
    iwctl device "$i" set-property Powered off
  else
    iwctl device "$i" set-property Powered on
  fi
}

eth_iface() {
  for i in /sys/class/net/e*; do
    [[ -e "$i" ]] || continue
    if [[ "$(cat $i/operstate 2>/dev/null)" == "up" ]]; then
      basename "$i"
      return
    fi
  done
}

mode() {
  if [[ -n "$(eth_iface)" ]]; then
    echo ethernet
  elif [[ "$(state)" == "on" ]]; then
    echo wifi
  else
    echo off
  fi
}

case "$1" in
  icon)       icon ;;
  percentage) percentage ;;
  ssid)       ssid ;;
  state)      state ;;
  toggle)     toggle ;;
  mode)       mode ;;
esac
