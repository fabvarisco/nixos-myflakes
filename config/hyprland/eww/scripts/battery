#!/usr/bin/env bash

BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1)

read_capacity() {
  [[ -n "$BAT" && -r "$BAT/capacity" ]] && cat "$BAT/capacity" || echo ""
}

read_status() {
  [[ -n "$BAT" && -r "$BAT/status" ]] && cat "$BAT/status" || echo "Unknown"
}

icon() {
  if [[ -z "$BAT" ]]; then
    echo "images/battery-100.svg"
    return
  fi
  local status lvl
  status=$(read_status)
  lvl=$(read_capacity)
  if [[ "$status" == "Charging" || "$status" == "Full" || "$status" == "Not charging" ]]; then
    echo "images/battery-charging.svg"
  elif [[ "$status" == "Discharging" ]]; then
    if   [[ $lvl -lt 20 ]]; then echo "images/battery-20.svg"
    elif [[ $lvl -lt 40 ]]; then echo "images/battery-40.svg"
    elif [[ $lvl -lt 60 ]]; then echo "images/battery-60.svg"
    elif [[ $lvl -lt 80 ]]; then echo "images/battery-80.svg"
    else                         echo "images/battery-100.svg"
    fi
  else
    echo "images/battery-100.svg"
  fi
}

number() {
  read_capacity
}

remaining() {
  [[ -z "$BAT" ]] && return
  local status e p min
  status=$(read_status)
  [[ "$status" != "Discharging" && "$status" != "Charging" ]] && return
  e=$(cat "$BAT/energy_now" 2>/dev/null) || return
  p=$(cat "$BAT/power_now"  2>/dev/null) || return
  [[ -z "$e" || -z "$p" || "$p" -le 0 ]] && return
  if [[ "$status" == "Charging" ]]; then
    local full
    full=$(cat "$BAT/energy_full" 2>/dev/null) || return
    [[ -z "$full" || "$full" -le "$e" ]] && return
    min=$(( (full - e) * 60 / p ))
  else
    min=$(( e * 60 / p ))
  fi
  if (( min >= 60 )); then
    printf '%dh %dm\n' $((min/60)) $((min%60))
  else
    printf '%dm\n' "$min"
  fi
}

case "$1" in
  icon)      icon ;;
  number)    number ;;
  remaining) remaining ;;
esac
