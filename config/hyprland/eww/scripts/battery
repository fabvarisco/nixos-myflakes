#!/usr/bin/env bash

BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1)

read_capacity() {
  [[ -n "$BAT" && -r "$BAT/capacity" ]] && cat "$BAT/capacity" || echo ""
}

read_status() {
  [[ -n "$BAT" && -r "$BAT/status" ]] && cat "$BAT/status" || echo "Unknown"
}

icon() {
  if [[ -z "$BAT" ]]; then
    echo "images/battery-100.svg"
    return
  fi
  local status lvl
  status=$(read_status)
  lvl=$(read_capacity)
  if [[ "$status" == "Charging" || "$status" == "Full" || "$status" == "Not charging" ]]; then
    echo "images/battery-charging.svg"
  elif [[ "$status" == "Discharging" ]]; then
    if   [[ $lvl -lt 20 ]]; then echo "images/battery-20.svg"
    elif [[ $lvl -lt 40 ]]; then echo "images/battery-40.svg"
    elif [[ $lvl -lt 60 ]]; then echo "images/battery-60.svg"
    elif [[ $lvl -lt 80 ]]; then echo "images/battery-80.svg"
    else                         echo "images/battery-100.svg"
    fi
  else
    echo "images/battery-100.svg"
  fi
}

number() {
  read_capacity
}

if [[ $1 == icon ]]; then
  icon
elif [[ $1 == number ]]; then
  number
fi
