#!/usr/bin/env bash

SHADER="blue-light-filter"

state() {
  current=$(hyprshade current 2>/dev/null)
  if [[ -n "$current" && "$current" != "off" ]]; then
    echo on
  else
    echo off
  fi
}

toggle() {
  if [[ "$(state)" == "on" ]]; then
    hyprshade off >/dev/null
  else
    hyprshade on "$SHADER" >/dev/null
  fi
}

case "$1" in
  state)  state ;;
  toggle) toggle ;;
esac
