#!/usr/bin/env bash
# Manage default audio sink (output) via wpctl (PipeWire/WirePlumber).

current() {
  wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null \
    | awk -F'"' '/node\.nick/ {print $2; exit}'
}

# Output: one "ID|Name" per line
list() {
  wpctl status 2>/dev/null \
    | awk '/^Audio/,/^Video/' \
    | sed -n '/├─ Sinks:/,/├─ Sources:/p' \
    | grep -oE '[0-9]+\..*\[vol' \
    | sed -E 's/\[vol[[:space:]]*$//; s/^([0-9]+)\.[[:space:]]*(.*)[[:space:]]*$/\1|\2/; s/[[:space:]]*$//'
}

set_default() {
  wpctl set-default "$1" >/dev/null
}

cycle() {
  ids=( $(list | cut -d'|' -f1) )
  [[ ${#ids[@]} -le 1 ]] && return
  cur_id=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null \
    | awk '/^id [0-9]+/ {gsub(",",""); print $2; exit}')
  for i in "${!ids[@]}"; do
    if [[ "${ids[$i]}" == "$cur_id" ]]; then
      next_idx=$(( (i + 1) % ${#ids[@]} ))
      set_default "${ids[$next_idx]}"
      return
    fi
  done
  set_default "${ids[0]}"
}

case "$1" in
  current) current ;;
  list)    list ;;
  set)     set_default "$2" ;;
  cycle)   cycle ;;
esac
