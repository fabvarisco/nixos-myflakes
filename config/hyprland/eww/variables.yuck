(deflisten br :initial "0" "scripts/brightness")

(deflisten vol-num :initial "0" "scripts/volume number")
(deflisten vol-icon :initial "images/volume-high.svg" "scripts/volume icon")

(deflisten mic-num  :initial "0" "scripts/mic number")
(deflisten mic-icon :initial "images/microphone.svg" "scripts/mic icon")

(defpoll sink-name      :interval "5s"  :initial "" "scripts/audio-sink current")
(defpoll source-name    :interval "5s"  :initial "" "scripts/audio-source current")

(defpoll power-profile  :interval "10s" :initial "balanced" "scripts/power-profile current")
(defpoll power-profile-label :interval "10s" :initial "Balanced" "scripts/power-profile label")
(defpoll power-profile-icon  :interval "10s" :initial "images/power-profile-balanced.svg" "scripts/power-profile icon")

(defpoll net-mode :interval "10s" :initial "wifi" "scripts/wifi mode")

(defpoll wifi-icon     :interval "2s"  :initial "images/wifi-off.svg" "scripts/wifi icon")
(defpoll wifi-state    :interval "2s"  :initial "off"               "scripts/wifi state")
(defpoll wifi-strength :interval "2s"  :initial "0%"                "scripts/wifi percentage")

(defpoll bat-icon :interval "10s" :initial "images/battery-100.svg" "scripts/battery icon")
(defpoll bat-num :interval "10s" :initial "" "scripts/battery number")
(defpoll bat-remaining :interval "30s" :initial "" "scripts/battery remaining")
(defpoll has-battery :interval "1h" :initial "false" "compgen -G '/sys/class/power_supply/BAT*' >/dev/null && echo true || echo false")

(defpoll wifi-ssid   :interval "2s"  :initial ""    "scripts/wifi ssid")
(defpoll bt-state    :interval "2s"  :initial "off" "scripts/bluetooth state")
(defpoll bt-device   :interval "2s"  :initial ""    "scripts/bluetooth device")
(defpoll night-light :interval "10s" :initial "off" "scripts/night-light state")
(defpoll airplane    :interval "10s" :initial "off" "scripts/airplane state")

(deflisten media-status :initial "Stopped" "playerctl --follow status 2>/dev/null || echo Stopped")
(deflisten media-title  :initial "" "playerctl --follow metadata --format '{{title}}' 2>/dev/null || echo ''")
(deflisten media-artist :initial "" "playerctl --follow metadata --format '{{artist}}' 2>/dev/null || echo ''")
(defpoll   media-art    :interval "3s" :initial "" "scripts/media art")

(defpoll ram :interval "5s" "free | awk '/Mem/{printf \"%.0f\", $3/$2*100}'")
(defpoll cpu :interval "5s" "scripts/cpu")

(defpoll time :interval "1s" "date '+%I:%M%P'")
(defpoll date :interval "1h" "LC_TIME=en_US.UTF-8 date '+%A %d %B, %Y'")

(deflisten numworkspaces "scripts/workspaces")

(deflisten notif :initial "{}" "scripts/notification-daemon")
(defpoll notif-history :interval "1s" :initial "[]" "scripts/notification-history-read")

(defpoll date-day  :interval "1h" "LC_TIME=en_US.UTF-8 date '+%A'")
(defpoll date-full :interval "1h" "LC_TIME=en_US.UTF-8 date '+%B %d, %Y'")

(defvar center-option "workspaces")
(defvar reveal-option "workspaces")
(defvar screenshot-option 1)
(defvar screenshot-reveal 0)
(defvar power-option 0)
(defvar power-reveal 0)
