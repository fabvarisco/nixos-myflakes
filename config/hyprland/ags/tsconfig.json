{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": ["ES2022"],
        "strict": true,
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "checkJs": true,
        "allowJs": true,
        "experimentalDecorators": true,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "astal/gtk3"
    },
    "include": ["./**/*"]
}
