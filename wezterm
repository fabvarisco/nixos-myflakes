local wezterm = require 'wezterm'
local config = wezterm.config_builder()

-- Helper to check if running on Windows
local is_windows = wezterm.target_triple:find("windows") ~= nil

-- Appearance
config.color_scheme = 'Tokyo Night' -- A popular, pleasing dark theme
config.font = wezterm.font 'Hack Nerd Font' -- Ensure you have this font installed
config.font_size = 11.0
config.window_background_opacity = 0.95
if is_windows then
  config.win32_system_backdrop = 'Acrylic'
else
  config.macos_window_background_blur = 20
end
config.window_decorations = "RESIZE" -- Minimal borders
config.initial_cols = 120
config.initial_rows = 30

-- Tab Bar
config.hide_tab_bar_if_only_one_tab = false
config.use_fancy_tab_bar = true
config.tab_bar_at_bottom = true

-- Shell Configuration
if is_windows then
  -- Default to PowerShell. 
  -- If you have PowerShell 7 (pwsh), you can change this to { 'pwsh', '-NoLogo' }
  config.default_prog = { 'powershell.exe', '-NoLogo' }
  
  -- Launch Menu for Windows
  config.launch_menu = {
    {
      label = 'PowerShell',
      args = { 'powershell.exe', '-NoLogo' },
    },
    {
      label = 'PowerShell 7',
      args = { 'pwsh', '-NoLogo' },
    },
    {
      label = 'CMD',
      args = { 'cmd.exe' },
    },
    {
      label = 'Git Bash',
      args = { 'C:\\Program Files\\Git\\bin\\bash.exe', '-l' },
    },
  }
else
  -- Mac/Linux defaults (usually zsh or bash)
  -- WezTerm detects the default user shell automatically
end

-- Keybindings
-- WezTerm has good defaults, but here are some common ones
config.keys = {
  -- CTRL+SHIFT+V to paste (standard terminal behavior)
  { key = 'V', mods = 'CTRL|SHIFT', action = wezterm.action.PasteFrom 'Clipboard' },
  -- CTRL+SHIFT+C to copy
  { key = 'C', mods = 'CTRL|SHIFT', action = wezterm.action.CopyTo 'ClipboardAndPrimarySelection' },
  
  -- Pane management
  { key = '"', mods = 'LEADER', action = wezterm.action.SplitVertical { domain = 'CurrentPaneDomain' } },
  { key = '%', mods = 'LEADER', action = wezterm.action.SplitHorizontal { domain = 'CurrentPaneDomain' } },
  { key = 'z', mods = 'LEADER', action = wezterm.action.TogglePaneZoomState },
}

-- Set a leader key (like tmux)
config.leader = { key = 'b', mods = 'CTRL', timeout_milliseconds = 1000 }

return config
